# Dataset path is relative to the project root.
DATA_PATH=data/support_tickets.csv

# Ollama is the recommended free, local provider for the assessment.
# The app falls back to deterministic, grounded analytics if Ollama is offline.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434

# Only needed for an OpenAI-compatible local/free-tier endpoint.
OPENAI_API_KEY=""
